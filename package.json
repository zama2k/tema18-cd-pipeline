{
  "name": "tema18-cd-pipeline",
  "version": "1.1.0",
  "private": true,
  "description": "Small Express API used to demonstrate a full CD pipeline (GitHub Actions, GHCR, Render, Vercel previews, Discord)",
  "main": "src/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest",
    "test:scripts": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include=\"scripts/**/*.mjs\" --test-coverage-exclude=\"scripts/dev/**\" \"tests/scripts/**/*.test.mjs\"",
    "test:ci": "npm test && npm run test:scripts",
    "build": "node scripts/build-check.mjs"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  }
}
