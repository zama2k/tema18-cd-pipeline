# Names only. Real values live in GitHub Secrets/Variables (see docs/setup.md).
# Runtime of the app (set in the Render service, not in GitHub):
PORT=3000
APP_ENV=development
# Baked into the image at build time (Dockerfile ARG): GIT_SHA, APP_VERSION

# --- GitHub repository secrets ---
DISCORD_WEBHOOK_URL=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- GitHub environment secrets (staging and production) ---
RENDER_API_KEY=

# --- GitHub environment variables (staging and production) ---
RENDER_SERVICE_ID=
APP_URL=
NODE_ENV=
